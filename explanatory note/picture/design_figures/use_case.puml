@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam packageStyle rectangle
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam ArrowFontSize 10
skinparam UsecaseFontSize 11
skinparam ActorFontSize 11

left to right direction

actor "Шахматист\n(игрок / оператор)" as Player
actor "Шахматный тренер /\nаналитик" as Analyst

rectangle "Гибридная интеллектуальная система регистрации партий" {
  usecase "Автоматическая видеорегистрация\nшахматной партии" as UC_Record
  usecase "Инициализация и калибровка\nвидеопотока и доски" as UC_Calib
  usecase "Разрешение спорных ситуаций\nи подтверждение хода" as UC_Resolve
  usecase "Компьютерный анализ\nи аудит сыгранной партии" as UC_Analyze
  usecase "Экспорт нотации партии\nв формат PGN" as UC_Export
}

Player --> UC_Record
Player --> UC_Export

Analyst --> UC_Analyze
Analyst --> UC_Export

UC_Record ..> UC_Calib : <<include>>
UC_Resolve ..> UC_Record : <<extend>>\n(при UNCERTAIN)

@enduml
